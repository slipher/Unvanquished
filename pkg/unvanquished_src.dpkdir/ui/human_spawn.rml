<rml>
<head>
	<link type="text/rcss" href="/ui/shared/basics.rcss" />
	<link type="text/template" href="/ui/shared/window_unmovable.rml" />
	<style>
		body {
			width: 30em;
			height: 10em;
			margin: auto;
		}
		body > * {
			font-size: 1.1em;
		}

		button {
			line-height: 1.45em;
		}

		button.rifle {
			width: 40%;
			float: left;
			margin-left: 0em;
		}

		button.ckit {
			width: 40%;
			float: right;
			margin-right: 0em;
		}

		button.joinqueue {
			font-size: 2em;
			margin-left: auto;
			margin-right: auto;
		}

		button.teamselect {
			width: 100%;
			margin-left: auto;
			margin-right: auto;
		}

		p {
			clear: both;
		}
	</style>
</head>
<body id="human_spawn" template="window_unmovable">
	<button class="joinqueue" onclick='Events.pushcmd("hide human_spawn; exec class rifle")'><translate>Join queue</translate></button>

	<button class="teamselect" onclick='Events.pushcmd("hide human_spawn; show ingame_teamselect")'><translate>Back to team selection</translate></button>
</body>
</rml>
